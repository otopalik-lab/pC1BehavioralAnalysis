% This script regenerates all of the plots that comprise Figure 5

%% Settings for Saving Plots:

SavePlot = 'True'; %set to 'True' if want to save plots in pC1BehavioralAnalysis/results; Set to 'False' if wish not to save (default)
SaveFormat = '.png'; %can change this as desired (see 'save' function in MATLAB for available formats'
SavePath = '/Users/otopalika/Documents/GitHub/pC1BehavioralAnalysis/results/figure5'; % can change as desired

%% If destination folder doesn't already exist, make it:

if ~exist(SavePath, 'dir')
    mkdir(SavePath);
end
%% Load Data and Metadata:

addpath(genpath('/Users/otopalika/Documents/GitHub/pC1BehavioralAnalysis'));
% load workspace with pre-generated data and randomly selected trials
% (SSinds) for each stable split line, for reproducible figures:
load('/Users/otopalika/Documents/GitHub/pC1BehavioralAnalysis/data/MaleMaleBehavior.mat');

% Load line and celltype lists:
selectedLines = table2struct(readtable('/Users/otopalika/Documents/GitHub/pC1BehavioralAnalysis/metadata/SSLines_withCelltypes.csv'));
lines = {selectedLines.Var1}; lines = lines([1 3:35]);
celltypes = {selectedLines.Var2}; celltypes = celltypes([1 3:35])

% Colormaps:

%% Plotting Dependencies and Parameters for Grouped Data:

% Get FieldNames
fieldNames = fieldnames(MaleMaleData); % Get FieldNames from struct:

% Get FPS:
FPS = MaleMaleData(1).FPS;

% Use 3 Highest LED Powers in assay for PSTH and Raster plots
LEDStims = [5:7]; % Stimulus periods to include (these are the three highest LED powers in the assay)

% Make Labels with SS line | Cell Types Format:
for i = 1:34 
    labels{i} = ([lines{i} ' | ' celltypes{i}]);
end

% Detect Epochs when LED on:
[LED_epochs,LED_durs] = detect_binarybouts(MaleMaleData(1).LED);
% Append a baseline period and generate stimulus and post-stimulus:
LED_on_epochs = [3600 5400; LED_epochs]; 

% List of randomly select 17 trials for each SS line
[m,numTrials] = size(SSinds); %indicies associated with each SS line (17 trials per line selected at random)

%% Figure 5A: Example of LED stimulus-aligned rasters of unilateral wing events, aggression events, and interfly distance for one example chamber:

color_list = {'#648FFF', '#DC267F','#FE6100'};
classifier_list = [find(strcmp(fieldNames,'unilateralwing')) find(strcmp(fieldNames,'aggression')) ];
line_idx = 23; % This is SS102571, specifying pC1_15abc

line_counter = 1;
counter = 1;

f=figure; clf
f.Position = [200, 700, 500, 700]; 
event_times_all = [];

for i = line_idx  
    subplot(4,1,1)
    %area(LED_epochs(1,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
    %area(LED_epochs(2,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
    %area(LED_epochs(3,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
    area(LED_epochs(4,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
    area(LED_epochs(5,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
    area(LED_epochs(6,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on     
    plot([1:length(MaleMaleData(1).LED)]./FPS, MaleMaleData(1).LED, 'k-','LineWidth',2)
    ylabel('LED (mW/cm^2)', 'FontSize', 12)
    xlim([0 length(MaleMaleData(1).LED)./60])
    ylim([0 4])
    title([labels(line_idx) 'N = 17'])
    p = 1;
    subplot(4,1,2)
    for k = 1:numTrials % one example chamber        
        ind = SSinds(i,k);         
           behav_temp = MaleMaleData(ind).unilateralwing;         
           event_times = [find(behav_temp == 1)];            
            if p == 1
                %area(LED_epochs(1,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
                %area(LED_epochs(2,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
                %area(LED_epochs(3,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
                area(LED_epochs(4,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
                area(LED_epochs(5,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
                area(LED_epochs(6,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
            end
            hold on;
            plot(event_times./FPS, p*ones(length(event_times),1), '|', 'MarkerFaceColor', color_list{1},'MarkerEdgeColor', color_list{1}, 'MarkerSize', 5); hold on
            ylabel('unilateral wing', 'FontSize', 12)
            ylim([0 18])
            xlim([0 length(behav_temp)/FPS])
            event_times_all = [event_times_all event_times];
            p = p+1;            
    end 
    p = 1;
    subplot(4,1,3)
    for k = 1:numTrials % one example chamber        
        ind = SSinds(i,k);         
           behav_temp = MaleMaleData(ind).aggression;         
           event_times = [find(behav_temp == 1)];            
            if p == 1
                %area(LED_epochs(1,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
                %area(LED_epochs(2,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
                %area(LED_epochs(3,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
                area(LED_epochs(4,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
                area(LED_epochs(5,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
                area(LED_epochs(6,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
            end
            hold on;
            plot(event_times./FPS, p*ones(length(event_times),1), '|', 'MarkerFaceColor', color_list{2},'MarkerEdgeColor', color_list{2}, 'MarkerSize', 5); hold on
            ylabel('aggression', 'FontSize', 12)
            ylim([0 18])
            xlim([0 length(behav_temp)/FPS])
            event_times_all = [event_times_all event_times];
            p = p+1;            
    end 
    % Plot Inter-fly distance:
    dist_traces = [];% traces span from LED start to 90 sec after LED
    for k = 1:numTrials
        SS_mat = [];
      
           ind = SSinds(i,k);
           temp = MaleMaleData(ind).dist_ctr;
           SS_mat = [SS_mat; temp];
        
        dist_traces = [dist_traces; SS_mat];
    end
    subplot(4,1,4)
    %area(LED_epochs(1,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
    %area(LED_epochs(2,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
    %area(LED_epochs(3,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
    area(LED_epochs(4,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
    area(LED_epochs(5,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
    area(LED_epochs(6,:)./FPS, [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
  
    shplot((1:length(dist_traces))./60, mean(dist_traces), std(dist_traces)/sqrt(length(LEDStims)*17), 'Color', color_list{3})
    ylim([0 20])
    xlim([0 length(behav_temp)/FPS])
    plot([0 length(behav_temp)/FPS], [6 6], 'k--', 'LineWidth',1)
    box off
    ylabel('Distance (mm)', 'FontSize',12)
    xlabel('seconds','FontSize', 12)
end

for i = 1:4
    subplot(4,1,i)
    box off
end


%If Save:
linename = (char(lines(i)));
cellname = char(celltypes(i)); cellname = erase(cellname, "\"); cellname = erase(cellname, " "); cellname = erase(cellname, ",");

if SavePlots
    cd(SavePath)
    saveas(f,[linename '_' cellname '_Fig5A_AlignedRastersDistance' SaveFormat])
end


%%



subplot(4,1,3)
if counter == 1
    area([30 60], [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
end
[d,edges] = psth(event_times_all,500,60,p-1,length(window)); 
area(edges./1000, d./60,'FaceColor', color_list{counter}, 'EdgeColor', color_list{counter}, 'FaceAlpha', 0.2, 'LineWidth',1.5); hold on   
xlim([0 length(window)/FPS])
ylabel('P(Behavior)', 'FontSize', 14)
ylim([0 1])
%xlabel('Time (s)', 'FontSize', 14)
box off
counter = counter+1;
subplot(4,1,1); title(labels(line_idx))

for m = 1:2
    subplot(4,1,m)
    axis off
    box off
end

% Plot Inter-fly distance:
dist_traces = [];% traces span from LED start to 90 sec after LED
    for k = 1:17
        SS_mat = [];
        for j = LEDStims
           ind = SSinds(i,k);
           temp = MaleMaleData(ind).dist_ctr(:,LED_on_epochs(j,1)-30*60:LED_on_epochs(j,2)+30*60);
           SS_mat = [SS_mat; temp];
        end
        dist_traces = [dist_traces; SS_mat];
    end
subplot(4,1,4)
area([30 60], [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
shplot((1:length(dist_traces))./60, mean(dist_traces), std(dist_traces)/sqrt(length(LEDStims)*17), 'Color', '#FE6100')
ylim([0 20])
xlim([0 90])
plot([0 90], [6 6], 'k--', 'LineWidth',1)
box off
ylabel('Distance (mm)', 'FontSize',14)
linename = (char(lines(i)));
cellname = char(celltypes(i)); cellname = erase(cellname, "\"); cellname = erase(cellname, " "); cellname = erase(cellname, ",");

if SavePlots
    cd(SavePath)
    saveas(f,[linename '_' cellname '_Fig5B_AlignedRastersPSTHDistance' SaveFormat])
end

line_counter = line_counter+1;






%% Figure 5B: Plot LED stimulus-aligned rasters, PSTHs, and Inter-fly Distances for Selected Lines

color_list = {'#648FFF', '#DC267F','#FE6100'};
classifier_list = [find(strcmp(fieldNames,'unilateralwing')) find(strcmp(fieldNames,'aggression')) ];


line_counter = 1;
for line_idx = [1 2 18 19 23 26 34]
counter = 1;
f=figure; clf
f.Position = [200*line_counter, 700, 200, 500]; 
for b = classifier_list
event_times_all = [];
%initalize counters:
for i = line_idx  
    p = 1;
    subplot(4,1,counter)
    for k = 1:numTrials % num trials for each line (I think)
        
        ind = SSinds(i,k); % to access one trial for that line
        for j = LEDStims            
           window = (LED_on_epochs(j,1)-30*60:LED_on_epochs(j,2)+30*60);
           behav_temp = MaleMaleData(ind).(fieldNames{b});         
           behav_temp = behav_temp(window); % only consider during specified peri-stimulus window
           event_times = [find(behav_temp == 1)]; %LED starts at 52200
           
            if p == 1
                area([30 60], [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
            end
            hold on;
            plot(event_times./FPS, p*ones(length(event_times),1), '|', 'MarkerFaceColor', color_list{counter},'MarkerEdgeColor', color_list{counter}, 'MarkerSize', 1); hold on
            ylabel([fieldNames(b)], 'FontSize', 14)
            ylim([0 50])
            xlim([0 length(behav_temp)/FPS])
            event_times_all = [event_times_all event_times];
            p = p+1;
        end        
    end 
end
subplot(4,1,3)
if counter == 1
    area([30 60], [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
end
[d,edges] = psth(event_times_all,500,60,p-1,length(window)); 
area(edges./1000, d./60,'FaceColor', color_list{counter}, 'EdgeColor', color_list{counter}, 'FaceAlpha', 0.2, 'LineWidth',1.5); hold on   
xlim([0 length(window)/FPS])
ylabel('P(Behavior)', 'FontSize', 14)
ylim([0 1])
%xlabel('Time (s)', 'FontSize', 14)
box off
counter = counter+1;
subplot(4,1,1); title(labels(line_idx))
end
for m = 1:2
    subplot(4,1,m)
    axis off
    box off
end

% Plot Inter-fly distance:
dist_traces = [];% traces span from LED start to 90 sec after LED
    for k = 1:17
        SS_mat = [];
        for j = LEDStims
           ind = SSinds(i,k);
           temp = MaleMaleData(ind).dist_ctr(:,LED_on_epochs(j,1)-30*60:LED_on_epochs(j,2)+30*60);
           SS_mat = [SS_mat; temp];
        end
        dist_traces = [dist_traces; SS_mat];
    end
subplot(4,1,4)
area([30 60], [50 50], 'FaceColor', [0 0 0], 'FaceAlpha', 0.1, 'LineStyle', 'none'); hold on
shplot((1:length(dist_traces))./60, mean(dist_traces), std(dist_traces)/sqrt(length(LEDStims)*17), 'Color', '#FE6100')
ylim([0 20])
xlim([0 90])
plot([0 90], [6 6], 'k--', 'LineWidth',1)
box off
ylabel('Distance (mm)', 'FontSize',14)
linename = (char(lines(i)));
cellname = char(celltypes(i)); cellname = erase(cellname, "\"); cellname = erase(cellname, " "); cellname = erase(cellname, ",");

if SavePlots
    cd(SavePath)
    saveas(f,[linename '_' cellname '_AlignedTimeseries_RastersPSTHDistance' SaveFormat])
end

line_counter = line_counter+1;

end  
%%


